{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naseej POS",
  "version": "0.1.0",
  "identifier": "com.naseej.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Naseej POS",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Offline apparel point of sale",
    "longDescription": "Encrypted local POS and inventory management for a single apparel store.",
    "category": "Business",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "Arabic"]
      }
    }
  }
}
